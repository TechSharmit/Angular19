import { HttpInterceptorFn } from '@angular/common/http';

export const loggingInterceptor: HttpInterceptorFn = (req, next) => {
 
  // Read the token from browser storage (null if it does not exist)
 
  const token = localStorage.getItem('token');

  // No token: send the original request unchanged

  if (!token) {
    return next(req);
  }

  // Requests are immutable, so create a modified COPY with the header added

  const authReq = req.clone({
    setHeaders: {
      Authorization: `Bearer ${token}`,
    },
  });

  // Send the modified copy, not the original
  
  return next(authReq);
};


