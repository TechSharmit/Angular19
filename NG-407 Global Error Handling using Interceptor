import { HttpInterceptorFn } from '@angular/common/http';
import { HttpErrorResponse } from '@angular/common/http';
import { catchError, throwError } from 'rxjs';

export const loggingInterceptor: HttpInterceptorFn = (req, next) => {
  return next(req).pipe(
    catchError((err: HttpErrorResponse) => {
      // One central place to react to errors
      if (err.status === 0) {
        console.log('Global handler: Network error');
      } else if (err.status === 401) {
        console.log('Global handler: Unauthorized (401)');
      } else if (err.status === 404) {
        console.log('Global handler: Not found (404)');
      } else if (err.status >= 500) {
        console.log('Global handler: Server error (' + err.status + ')');
      }

      // Pass the error forward so the component can still react to it
      return throwError(() => err);
    }),
  );
};


