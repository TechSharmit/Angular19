// Handling Loading State in GET API

import { Component } from '@angular/core';

import { CommonModule } from '@angular/common';
import { HttpClient, HttpErrorResponse } from '@angular/common/http';

@Component({
  selector: 'app-comp1',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './comp1.component.html',
  styleUrl: './comp1.component.css',
})
export class Comp1Component {
  users: any[] = [];
  
  isLoading: boolean = true;

  // One flag per error type, instead of one generic "hasError"
  isUnauthorized: boolean = false; // 401
  isForbidden: boolean = false; // 403
  isNotFound: boolean = false; // 404
  isServerError: boolean = false; // 500
  isOtherError: boolean = false; // anything else (network error, etc.)

  constructor(private http: HttpClient) {
    
    // Intentionally wrong URL, to trigger an error (change status codes by testing different mock APIs)
    
    this.http
      .get<any[]>('https://jsonplaceholder.typicode.com/usersxyz')
      .subscribe({
        next: (response) => {
          this.users = response;
          this.isLoading = false;
        },
        error: (err: HttpErrorResponse) => {
          this.isLoading = false;

          switch (err.status) {
            case 401:
              this.isUnauthorized = true; // User is not logged in / invalid token
              break;
            case 403:
              this.isForbidden = true; // User is logged in but not allowed
              break;
            case 404:
              this.isNotFound = true; // Resource does not exist
              break;
            case 500:
              this.isServerError = true; // Something broke on the server side
              break;
            default:
              this.isOtherError = true; // Network error, timeout, unknown status
              break;
          }
        },
      });
  }
}
