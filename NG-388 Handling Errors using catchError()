import { Component } from '@angular/core';

import { CommonModule } from '@angular/common';
import { HttpClient } from '@angular/common/http';
import { catchError } from 'rxjs/operators';
import { HttpErrorResponse } from '@angular/common/http';
import { of } from 'rxjs';

@Component({
  selector: 'app-comp1',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './comp1.component.html',
  styleUrl: './comp1.component.css',
})
export class Comp1Component {
  constructor(private http: HttpClient) {
    this.http
      .get<any[]>('https://jsonplaceholder.typicode.com/usersxyz') // Intentionally incorrect URL to trigger an error
      .pipe(
        catchError((err: HttpErrorResponse) => {
          console.log('Error caught in pipe:', err.status);
          return of([]); // Return a fallback empty array instead of crashing
        }),
      )
      .subscribe((response) => {
        console.log('Final data (or fallback):', response);
      });
  }
}

