import { Injectable } from '@angular/core';

@Injectable({ providedIn: 'root' })
export class LoadingService {
  // Counts how many requests are currently running
  activeRequests = 0;

  get isLoading(): boolean {
    return this.activeRequests > 0;
  }
}

📄 interceptors/loading.interceptor.ts

import { HttpInterceptorFn } from '@angular/common/http';
import { inject } from '@angular/core';
import { finalize } from 'rxjs';
import { LoadingService } from '../loading.service';

export const loadingInterceptor: HttpInterceptorFn = (req, next) => {
  // Interceptors are functions, so we use inject() instead of a constructor
  const loadingService = inject(LoadingService);

  // A request is starting
  loadingService.activeRequests++;

  return next(req).pipe(
    // Runs on success AND error, when the request ends
    finalize(() => {
      loadingService.activeRequests--;
    })
  );
};

