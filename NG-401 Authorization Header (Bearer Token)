import { Component } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { CommonModule } from '@angular/common';
import { HttpHeaders } from '@angular/common/http';
import { HttpErrorResponse } from '@angular/common/http';

@Component({
  selector: 'app-comp1',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './comp1.component.html',
  styleUrl: './comp1.component.css',
})
export class Comp1Component {
  constructor(private http: HttpClient) {
    // A demo token. In real apps this comes from the server after login

    const token = 'my-demo-token-123';

    // "Bearer" + space + token is the standard format

    const headers = new HttpHeaders({
      Authorization: `Bearer ${token}`,
    });

    this.http.get<any>('https://httpbin.org/bearer').subscribe({
      next: (response) => console.log('Success:', response),
      error: (err: HttpErrorResponse) =>
        console.log('Failed, status:', err.status),
    });
  }
}


<p>Check the browser console. Then try removing the headers and run again.</p>
