import { Component } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-comp1',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './comp1.component.html',
  styleUrl: './comp1.component.css',
})
export class Comp1Component {
  user: any = null;
  posts: any[] = [];

  constructor(private http: HttpClient) {
    // Step 1: First get the user
    this.http
      .get<any>('https://jsonplaceholder.typicode.com/users/1')
      .subscribe((userResponse) => {
        this.user = userResponse;

        // Step 2: Use the user's ID to fetch their posts
        this.http
          .get<
            any[]
          >(`https://jsonplaceholder.typicode.com/posts?userId=${this.user.id}`)
          .subscribe((postsResponse) => {
            this.posts = postsResponse;
          });
      });
  }
}
