import { Component } from '@angular/core';

import { CommonModule } from '@angular/common';
import { HttpClient, HttpErrorResponse } from '@angular/common/http';
import { timeout } from 'rxjs/operators';

@Component({
  selector: 'app-comp1',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './comp1.component.html',
  styleUrl: './comp1.component.css',
})
export class Comp1Component {
  constructor(private http: HttpClient) {
    this.http
      .get<any[]>('https://jsonplaceholder.typicode.com/users') // Intentionally incorrect URL to simulate a failed request
      .pipe(
        timeout(3000), // Cancel the request if no response within 3000ms
      )
      .subscribe({
        next: (response) => {
          console.log('Data received:', response);
        },
        error: (err: HttpErrorResponse) => {
          console.log('Request failed or timed out:', err);
        },
      });
  }
}

<p>Check the browser console for the logs.</p>
